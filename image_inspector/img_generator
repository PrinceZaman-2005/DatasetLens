import os
from PIL import Image

# 1. Create directory
target_dir = "./testset/images"
os.makedirs(target_dir, exist_ok=True)

# 2. Generate valid images in different formats and colors
Image.new("RGB", (100, 100), color="red").save(f"{target_dir}/sample_red.jpg")
Image.new("RGBA", (200, 200), color="blue").save(f"{target_dir}/sample_blue.png")
Image.new("L", (150, 150), color=128).save(f"{target_dir}/sample_gray.bmp")

# 3. Create a fake corrupted image file
with open(f"{target_dir}/corrupt_image.jpg", "wb") as f:
    f.write(b"NOT_A_REAL_IMAGE_HEADER_DATA")

print(f"Sample dataset created in {target_dir}")